# 日記Bot 環境変数。実値はここに書かず、コピーして .env.local に書くか
# Vercel / Claude Code on the web の環境変数に登録すること（チャットに貼らない）。

# --- AI（設計書セクション2） ---
# 既定は gemini。claude に切り替えるなら DIARY_AI_PROVIDER=claude
DIARY_AI_PROVIDER=gemini
# Gemini: https://aistudio.google.com → 「Get API key」で発行（無料枠あり）
GEMINI_API_KEY=
DIARY_GEMINI_MODEL=gemini-2.5-flash
# Claude に差し替える場合のみ: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
DIARY_CLAUDE_MODEL=claude-opus-4-7

# --- Supabase（設計書セクション8） ---
# https://supabase.com → New project → Project Settings → API / Database
# schema.sql は SQL Editor に貼って実行しておくこと
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LINE Messaging API（設計書セクション2） ---
# LINE 公式アカウントマネージャー（https://manager.line.biz）
#   → 設定 → Messaging API のページに Channel ID と Channel secret が表示される。
# アクセストークンは Channel ID + Channel secret から都度発行する
# （ステートレスチャネルアクセストークン方式。発行ボタンを探す必要なし）。
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 自分の LINE userId（これ以外のユーザーは自動登録しない。空なら誰でも登録可）。
# 不明なら空のままでよい（後で Bot に話しかければログから取得できる）。
DIARY_OWNER_LINE_USER_ID=

# --- Cron 認証（既存 reminders と共用） ---
# Vercel Cron からの呼び出しを認証する任意の秘密文字列
CRON_SECRET=

# --- カレンダー連携 ---
# 連携自体は server-store を直接参照するためキー不要。
# 各ユーザーの共有トークンは diary_users.calendar_share_token に保存する。
